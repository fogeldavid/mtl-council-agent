# Local preview configuration. Never commit real credentials.
# Use the read-only connection for your EXISTING, populated council database.
WEB_DATABASE_URL=

# Optional shared key for chat in this local preview.
# Without this, chat is disabled; visitors are never asked for keys.
WEB_ANTHROPIC_API_KEY=

# Uses the same generation model as the existing app.
MTL_AGENT_MODEL=claude-haiku-4-5
